{
  "name": "smart-home-dashboard",
  "version": "1.0.0",
  "description": "Responsive smart home dashboard with Node.js backend and Vue.js frontend.",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client:dev\"",
    "server": "node server.js",
    "client:dev": "cd frontend && npm run dev",
    "client:build": "cd frontend && npm run build",
    "build": "npm run client:build",
    "start": "npm run client:build && node server.js"
  },
  "author": "GitHub Copilot",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
